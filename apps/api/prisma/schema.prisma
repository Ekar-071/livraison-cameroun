generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum StatutVille {
  ACTIVE
  INACTIVE
}


enum StatutCommande {
  EN_ATTENTE
  CONFIRMEE
  EN_PREPARATION
  EN_LIVRAISON
  LIVREE
  ANNULEE
}

enum ModePaiement {
  ESPECES
  ORANGE_MONEY
  MTN_MOMO
}

model Ville {
  id               String        @id @default(cuid())
  nom              String        @unique
  statut           StatutVille   @default(ACTIVE)

  utilisateurs     Utilisateur[]
  commerces        Commerce[]

  dateCreation     DateTime      @default(now())
  dateModification DateTime      @updatedAt
}

model Utilisateur {
  id               String        @id @default(cuid())
  prenom           String
  nom              String
  telephone        String        @unique
  email            String?       @unique
  motDePasse       String
  role             Role          @default(CLIENT)

  villeId          String?
  ville            Ville?        @relation(fields: [villeId], references: [id])

  commerces        Commerce[]
  commandes        Commande[]

  dateCreation     DateTime      @default(now())
  dateModification DateTime      @updatedAt
}

model Commerce {
  id               String        @id @default(cuid())

  nom              String
  description      String?
  adresse          String
  telephone        String
  image            String?
  ouvert           Boolean       @default(true)

  villeId          String
  ville            Ville         @relation(fields: [villeId], references: [id])

  produits Produit[]

  proprietaireId   String?
  proprietaire     Utilisateur?  @relation(fields: [proprietaireId], references: [id])

  dateCreation     DateTime      @default(now())
  dateModification DateTime      @updatedAt
}

model Produit {
  id               String   @id @default(cuid())

  nom              String
  description      String?
  prix             Decimal  @db.Decimal(10, 2)
  image            String?
  disponible       Boolean  @default(true)
  commandeItems    CommandeItem[]

  commerceId       String
  commerce         Commerce @relation(fields: [commerceId], references: [id])

  dateCreation     DateTime @default(now())
  dateModification DateTime @updatedAt
}

model Commande {
  id               String           @id @default(cuid())

  utilisateurId    String
  utilisateur      Utilisateur      @relation(fields: [utilisateurId], references: [id])

  montantTotal     Decimal          @db.Decimal(10,2)

  statut           StatutCommande   @default(EN_ATTENTE)
  modePaiement     ModePaiement

  items            CommandeItem[]

  dateCreation     DateTime @default(now())
  dateModification DateTime @updatedAt
}

model CommandeItem {
  id               String    @id @default(cuid())

  commandeId       String
  commande         Commande  @relation(fields: [commandeId], references: [id])

  produitId        String
  produit          Produit   @relation(fields: [produitId], references: [id])

  quantite         Int

  prixUnitaire     Decimal   @db.Decimal(10,2)

  dateCreation     DateTime @default(now())
}
